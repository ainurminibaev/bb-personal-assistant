#!/usr/bin/env python3
"""vallis-commitments — the list of commitments between people and the daily digest of a group chat (С91, С92).

The agent reads a day of a chat once, in one turn: `collect` pulls the day from the bridge's conversation archive
(no model call per message), the agent writes down what people promised and agreed, `render` makes the digest.
The list holds one record per commitment: who, for whom, what, due, where it was said (a link), state, next step.
The text of the chat is not copied into the list — only the wording of the commitment and the link to the message.

  vallis-commitments chats add CHAT [--title T] [--post on|off]
                                                     a group whose commitments are collected (CHAT: its Telegram ID);
                                                     --post on: the group also gets its own digest, of this chat only
  vallis-commitments chats remove CHAT | chats list
  vallis-commitments set [--timezone Z] [--language ru|en] [--pdf on|off]
                                                     --pdf on: the owner's digest also as a PDF file
  vallis-commitments collect [--chat CHAT] [--date YYYY-MM-DD] [--from-start]
                                                     the new messages of the day as a short transcript (a file) and
                                                     the open commitments of the chat; each chat separately
  vallis-commitments add --chat CHAT --who NAME --what TEXT --message N [--who-id ID] [--for NAME] [--due D]
                         [--topic T] [--link URL] [--kind promise|request|decision] [--unsure] [--tracker REF]
                         [--next TEXT] [--date YYYY-MM-DD]
                                                     write a commitment down; the same message and person again
                                                     updates the record instead of adding a second one
  vallis-commitments close ID [--cancelled] --by NAME [--message N] [--link URL] [--note TEXT] [--date D]
                                                     done (default) or cancelled («вопрос снят»)
  vallis-commitments update ID [--what T] [--who N] [--who-id ID] [--for N] [--due D|none] [--next T] [--tracker R]
                         [--sure] [--by NAME] [--message N] [--note TEXT] [--date D]
                                                     «решили иначе», a new due date, a confirmed uncertain record
  vallis-commitments reopen ID --by NAME [--note TEXT]
  vallis-commitments list [--chat CHAT] [--who NAME] [--all] [--json]
                                                     open commitments; --who: of one person (part of the name)
  vallis-commitments post (--owner | --chat CHAT | --for ID) [--date D] [--comment TEXT | --comment-file PATH] [--pdf]
                                                     compose the digest and send it in one step: to the owner — of all
                                                     chats; to a chat — of that chat only (it must have --post on);
                                                     to a recipient — of the chats that person writes in. The address
                                                     comes from the same argument as the content: a chat's digest
                                                     cannot go to another chat. A day with nothing to tell is not sent
  vallis-commitments render [--date YYYY-MM-DD] [--chat CHAT] [--comment TEXT | --comment-file PATH]
                         [--for ID] [--pdf] [--out PATH]
                                                     the digest of the day in Markdown: new, closed, changed, overdue,
                                                     due soon, open, to clarify; kept by date in digests/.
                                                     only composes, sends nothing — to look at it; --chat: of one
                                                     chat only; --for: for a recipient, the chats that person writes in; --pdf: also a PDF made by vallis-pdf. Prints the paths,
                                                     the counts and "send": false when the day has nothing to tell

  vallis-commitments mine --chat CHAT [--who NAME]   for a group's conversation: the open commitments of this chat
  vallis-commitments mine --person ID [--done N | --dropped N] [--note TEXT]
                                                     for a person's private chat: their own open commitments, only
                                                     from chats they take part in; they may close their own
  vallis-commitments recipients add ID --name NAME | recipients remove ID | recipients list
                                                     people besides the owner who get a digest — each only of the
                                                     chats they write in themselves (`render --for ID`)
  vallis-commitments guide                           how the daily run reads a day: what is a commitment, what is not

The list lives in one place of the installation and nowhere else: ~/.local/share/vallis/commitments of the
agent's account (config.json, ledger.json, journal.jsonl, transcripts/<date>/<chat>.txt, digests/<date>.md). There
is no setting or variable that moves it: every conversation of the installation must see the same list. If the
folder cannot be written, the command says so — tell the owner, do not keep a list anywhere else.
The archive is read with `bb telegram-projects search-history`, so the caller sees only what its conversation may see:
run it from the owner's conversation or its subthread. Private chats are never read: only groups (negative IDs).
`mine` is the only command for a group's or a person's conversation: it shows what the bridge lets that conversation
read anyway — the chat itself, or the person's own promises.
"""
import argparse
import datetime as dt
import fcntl
import json
import os
import subprocess
import sys
import tempfile
from contextlib import contextmanager
from pathlib import Path
from zoneinfo import ZoneInfo

PAGE = 200                      # the archive returns at most this many messages per call
MAX_PAGES = 50                  # a day of 10 000 messages is not a working chat: stop and say so
KINDS = ("promise", "request", "decision")
OPEN, DONE, CANCELLED, NOTED = "open", "done", "cancelled", "noted"

