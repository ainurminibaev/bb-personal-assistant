def fail(message, code=1):
    print(message, file=sys.stderr)
    sys.exit(code)


def home():
    return Path.home() / ".local/share/vallis/commitments"   # one place per installation; deliberately not configurable


def bb(*words):
    return [os.environ.get("BB_CLI") or "bb", "telegram-projects", *words]


def read_json(path, default):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (FileNotFoundError, NotADirectoryError):
        return default


def write_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".")
    with os.fdopen(fd, "w", encoding="utf-8") as out:
        json.dump(value, out, ensure_ascii=False, indent=1)
        out.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


@contextmanager
def locked():
    """One writer at a time: the daily run and a person's «снято» may come together."""
    root = home()
    try:
        root.mkdir(parents=True, exist_ok=True)
        os.chmod(root, 0o700)
        lock = open(root / ".lock", "w")
    except OSError as error:
        fail(f"the list of commitments cannot be written ({root}: {error.strerror}). It lives only there: do not keep "
             "it anywhere else — tell the owner that the commitments are not available on this installation yet.")
    with lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield root


def config(root):
    cfg = read_json(root / "config.json", {})
    cfg.setdefault("chats", {})
    cfg.setdefault("timezone", "Europe/Moscow")
    cfg.setdefault("language", "ru")
    cfg.setdefault("collected", {})   # chat → UTC second of the last message already in a rendered digest
    cfg.setdefault("pending", {})     # chat → the same for a collected day whose digest is not rendered yet
    return cfg


def zone(cfg):
    try:
        return ZoneInfo(cfg["timezone"])
    except Exception:
        fail(f"unknown time zone {cfg['timezone']}: vallis-commitments set --timezone <IANA zone>", 64)


def today(cfg):
    return dt.datetime.now(zone(cfg)).date().isoformat()


def day(value, cfg):
    if not value:
        return today(cfg)
    try:
        return dt.date.fromisoformat(value).isoformat()
    except ValueError:
        fail(f"a date is YYYY-MM-DD, got {value}", 64)


def group(value):
    """Only groups: a private chat has a positive ID and is never collected."""
    try:
        chat = int(str(value).strip())
    except ValueError:
        fail(f"a chat is its Telegram ID (a negative number), got {value}", 64)
    if chat >= 0:
        fail("private chats are not collected: only groups (negative chat IDs)", 64)
    return str(chat)


def due(value):
    """YYYY-MM-DD or YYYY-MM-DDTHH:MM, kept as written: the time zone is the organization's."""
    if value in (None, "", "none"):
        return None
    for form in ("%Y-%m-%d", "%Y-%m-%dT%H:%M"):
        try:
            dt.datetime.strptime(value, form)
            return value
        except ValueError:
            pass
    fail(f"a due date is YYYY-MM-DD or YYYY-MM-DDTHH:MM, got {value}", 64)


def journal(root, record, event, **more):
    line = {"at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"), "id": record["id"], "event": event, **more}
    with open(root / "journal.jsonl", "a", encoding="utf-8") as out:
        out.write(json.dumps(line, ensure_ascii=False) + "\n")
    os.chmod(root / "journal.jsonl", 0o600)


def ledger(root):
    return read_json(root / "ledger.json", {"next": 1, "items": []})


def find(book, number):
    try:
        wanted = int(str(number).lstrip("#№"))
    except ValueError:
        fail(f"a commitment is named by its number, got {number}", 64)
    for item in book["items"]:
        if item["id"] == wanted:
            return item
    fail(f"no commitment {wanted}: vallis-commitments list --all")


def link_of(chat, topic, message):
    chat = str(chat)
    if not chat.startswith("-100") or not message:
        return None
    return f"https://t.me/c/{chat[4:]}/{str(topic) + '/' if topic else ''}{message}"


# ── reading the archive ──────────────────────────────────────────────────────────────────────────────────────────

def history(arguments):
    command = bb("search-history")
    done = subprocess.run(command + arguments, capture_output=True, text=True)
    if done.returncode:
        reason = (done.stderr or done.stdout).strip()
        if "telegram_conversation_required" in reason:
            reason += " — run from the owner's Telegram conversation or its subthread"
        fail(f"the conversation archive did not answer: {reason}")
    try:
        return json.loads(done.stdout).get("messages", [])
    except (ValueError, AttributeError):
        fail("the conversation archive answered with something that is not JSON")


def asked(arguments):
    """The archive's answer, or nothing when it refuses: a refusal means «not for this conversation»."""
    command = bb("search-history")
    try:
        done = subprocess.run(command + arguments, capture_output=True, text=True, timeout=120)
        return json.loads(done.stdout).get("messages", []) if done.returncode == 0 else []
    except (OSError, ValueError, AttributeError, subprocess.TimeoutExpired):
        return []


def readable(chat):
    """Whether the calling conversation may read this chat: the bridge decides, by the thread that calls."""
    return any(str(m.get("chat")) == str(chat) for m in asked(["--chat", str(chat), "--last", "1"]))


def writes_in(person, chat):
    """Whether the person takes part in the chat: has written there, as the bridge itself counts membership."""
    return any(str(m.get("chat")) == str(chat) and m.get("authorId") == person
               for m in asked(["--chat", str(chat), "--author", str(person), "--last", "1"]))


def seconds(iso):
    return int(dt.datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp())


def utc(second):
    return dt.datetime.fromtimestamp(second, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")


def fetch(chat, start, end):
    """Every message of the chat between two UTC seconds, oldest first. The archive gives the last 200 of a
    period, so the period is read from its end backwards until a page comes short."""
    found = {}
    for _ in range(MAX_PAGES):
        page = history(["--chat", chat, "--from", utc(start), "--to", utc(end), "--tz", "UTC", "--last", str(PAGE)])
        fresh = [m for m in page if str(m.get("chat")) == chat and m["message"] not in found]
        for m in fresh:
            found[m["message"]] = m
        if len(page) < PAGE or not fresh:
            break
        end = min(seconds(m["date"]) for m in page)
    else:
        fail(f"chat {chat}: more than {PAGE * MAX_PAGES} messages in the period — narrow it with --date")
    return sorted(found.values(), key=lambda m: (seconds(m["date"]), m["message"]))


def transcript(messages, tz):
    """One line per message: local time, message number, the message it answers, author, text."""
    lines, topic = [], object()
    for m in messages:
        if m.get("topic", 0) != topic:
            topic = m.get("topic", 0)
            lines.append(f"\n== topic {topic} ==")
        when = dt.datetime.fromtimestamp(seconds(m["date"]), tz).strftime("%m-%d %H:%M")
        text = " ".join(str(m.get("text") or "").split())
        if m.get("transcript"):
            text = (text + " " if text else "") + "[voice] " + " ".join(str(m["transcript"]).split())
        if m.get("file"):
            text = (text + " " if text else "") + f"[file: {m['file'].get('name') or m['file'].get('kind') or 'file'}]"
        reply = f" ↩{m['replyTo']}" if m.get("replyTo") else ""
        lines.append(f"[{when} #{m['message']}{reply}] {m.get('author') or '?'} ({m.get('authorId', '?')}): {text}")
    return "\n".join(lines).strip() + "\n"


def brief(item, lang="en"):
    t = TEXT[lang]
    parts = [f"{item['id']}. {item['who']}: {item['what']}"]
    if item.get("for"):
        parts.append(f"{t['for']} {item['for']}")
    parts.append(f"{t['due']} {item['due']}" if item.get("due") else t["no_due"])
    return " — ".join(parts)


def cmd_collect(args):
    with locked() as root:
        cfg = config(root)
        tz, date = zone(cfg), day(args.date, cfg)
        chats = [group(args.chat)] if args.chat else sorted(cfg["chats"])
        if not chats:
            fail("no chats to collect: vallis-commitments chats add <chat ID> --title <title>")
        for chat in chats:
            if chat not in cfg["chats"]:
                fail(f"chat {chat} is not in the list: vallis-commitments chats add {chat}")
        local = dt.date.fromisoformat(date)
        day_start = int(dt.datetime.combine(local, dt.time.min, tz).timestamp())
        day_end = int(dt.datetime.combine(local, dt.time.max, tz).timestamp())
        book, report = ledger(root), []
        for chat in chats:
            last = cfg["collected"].get(chat)
            # A missed day is not lost: reading starts after the last message of the previous digest, at most a week back.
            start = day_start if args.from_start or last is None else max(min(last + 1, day_start), day_start - 7 * 86400)
            messages = fetch(chat, start, day_end)
            path = root / "transcripts" / date / f"{chat}.txt"
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(transcript(messages, tz), encoding="utf-8")
            os.chmod(path, 0o600)
            if messages:
                cfg["pending"][chat] = max(seconds(m["date"]) for m in messages)
                titled = next((m.get("chatTitle") for m in reversed(messages) if m.get("chatTitle")), None)
                if titled and not cfg["chats"][chat].get("title"):
                    cfg["chats"][chat]["title"] = titled
            cfg.setdefault("counts", {}).setdefault(date, {})[chat] = len(messages)
            report.append({
                "chat": chat, "title": cfg["chats"][chat].get("title") or chat, "date": date, "messages": len(messages),
                "transcript": str(path), "post": bool(cfg["chats"][chat].get("post")),
                "open": [brief(i) + (f" [#{i['source']['message']}]" if i["source"].get("message") else "")
                         for i in book["items"] if i["chat"] == chat and i["state"] == OPEN],
            })
        write_json(root / "config.json", cfg)
    print(json.dumps(report, ensure_ascii=False, indent=1))


# ── the list ─────────────────────────────────────────────────────────────────────────────────────────────────────

def cmd_add(args):
    with locked() as root:
        cfg, book = config(root), ledger(root)
        chat = group(args.chat)
        if chat not in cfg["chats"]:
            fail(f"chat {chat} is not in the list: vallis-commitments chats add {chat}")
        date = day(args.date, cfg)
        if args.kind != "decision" and not args.who_id:
            # Without the person's ID the promise cannot be shown to them in their private chat or closed by them.
            fail("--who-id is needed: the Telegram ID of the one who promised (the number in brackets after the "
                 "author's name in the transcript)", 64)
        fields = {
            "who": args.who.strip(), "who_id": args.who_id, "for": (args.for_ or "").strip() or None,
            "what": " ".join(args.what.split()), "due": due(args.due), "kind": args.kind,
            "sure": not args.unsure, "tracker": args.tracker, "next": args.next,
        }
        same = next((i for i in book["items"] if i["chat"] == chat and i["source"].get("message") == args.message
                     and i["who"].casefold() == fields["who"].casefold() and i["kind"] == args.kind), None)
        if same:   # the day was read twice: the record is corrected, not doubled; a closed one stays closed
            changed = {k: v for k, v in fields.items() if v is not None and same.get(k) != v and k != "sure"}
            same.update(changed)
            if changed:
                journal(root, same, "corrected", fields=sorted(changed))
            item = same
        else:
            item = {
                "id": book["next"], "chat": chat, **fields,
                # An agreement nobody has to carry out is kept by date, but is not an open commitment.
                "state": NOTED if args.kind == "decision" else OPEN,
                "source": {"topic": args.topic or 0, "message": args.message,
                           "link": args.link or link_of(chat, args.topic, args.message)},
                "opened": date, "changed": None, "closed": None, "history": [],
            }
            book["next"] += 1
            book["items"].append(item)
            journal(root, item, "added", chat=chat, message=args.message)
        write_json(root / "ledger.json", book)
    print(json.dumps({"id": item["id"], "state": item["state"], "repeated": bool(same)}, ensure_ascii=False))


def note(item, date, event, args):
    entry = {"date": date, "event": event, "by": getattr(args, "by", None)}
    message = getattr(args, "message", None)
    if message:
        entry["message"] = message
        entry["link"] = getattr(args, "link", None) or link_of(item["chat"], item["source"].get("topic"), message)
    if getattr(args, "note", None):
        entry["note"] = args.note
    item["history"].append(entry)
    return entry


