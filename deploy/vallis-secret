#!/usr/bin/env python3
"""Хранилище доступов агента (С37): по файлу sops+age на ключ, без службы.

Значения никогда не печатаются и не передаются в аргументах. Открыто в файле только описание:
имя, назначение, уровень, источник, кто и когда завёл. Расшифровать файл может своя учётка
(свой ключ age) и администратор (его публичные ключи — получатели каждого файла).

  vallis-secret init                         — завести ключ age учётки и папки хранилища; печатает публичный ключ
  vallis-secret put NAME --what TEXT (--generate [--length N] | --stdin) [--source agent|handed]
                                             — положить своё: сгенерировать пароль или взять значение со входа
  vallis-secret ask NAME --what TEXT         — попросить значение у человека формой BB (bb secret request)
  vallis-secret import NAME --file PATH --what TEXT [--source handed]
                                             — положить содержимое существующего файла (перенос, файл не читается вслух)
  vallis-secret run NAME... -- COMMAND...    — запустить команду, значения — в её переменных окружения
  vallis-secret file NAME PATH               — расшифровать в файл 0600 (для программ, которым нужен файл)
  vallis-secret header NAME [--scheme Bearer] [--header Authorization]
                                             — заголовок для MCP (headersHelper Claude Code): читает Claude, не агент
  vallis-secret list [--json] [--verify]     — что есть, без значений; --verify — расшифровывается ли каждый
  vallis-secret remove NAME                  — удалить своё
  vallis-secret leaks [--git-staged | PATH...]
                                             — найти значения своих ключей в файлах или в подготовленном коммите;
                                               печатает только имя ключа и файл
  vallis-secret receive FILE                 — принять ключ организации, выданный администратором, в org/
  vallis-secret grant NAME --what TEXT --to FILE (--stdin | --generate) --out PATH
                                             — администратор: ключ организации для получателей (публичные ключи age
                                               по строке в FILE) и для себя; файл PATH передаётся получателям

Пути: ключ ~/.config/vallis/age.key (VALLIS_AGE_KEY), хранилище ~/.local/share/vallis/secrets
(VALLIS_SECRETS_DIR) с папками own/ и org/, ключи администратора ~/.config/vallis/admin.recipients
(VALLIS_ADMIN_RECIPIENTS), программы sops и age-keygen (VALLIS_SOPS, VALLIS_AGE_KEYGEN).
"""
import argparse
import datetime
import getpass
import json
import os
import re
import secrets as rnd
import shutil
import stat
import string
import subprocess
import sys
import tempfile

NAME = re.compile(r"^[A-Z][A-Z0-9_]{0,63}$")
OPEN_FIELDS = ("name", "what", "level", "source", "created", "created_by", "updated", "encoding")
UNENCRYPTED = "^(" + "|".join(OPEN_FIELDS) + ")$"
LEVELS = ("own", "org")
SOURCES = ("agent", "handed", "preset")
MAX_VALUE = 64 * 1024


class Fail(Exception):
    pass


def env_path(var, default):
    return os.path.abspath(os.path.expanduser(os.environ.get(var) or default))


def key_path():
    return env_path("VALLIS_AGE_KEY", "~/.config/vallis/age.key")


def store_path():
    return env_path("VALLIS_SECRETS_DIR", "~/.local/share/vallis/secrets")


def admin_path():
    return env_path("VALLIS_ADMIN_RECIPIENTS", "~/.config/vallis/admin.recipients")


def program(var, name):
    found = os.environ.get(var) or shutil.which(name)
    if not found:
        raise Fail(f"{name} not found: install it or set {var}")
    return found


def check_name(name):
    if not NAME.match(name or ""):
        raise Fail(f"name {name!r}: capital letters, digits and _, starting with a letter (for example SITE_X_PASSWORD)")
    return name


def private_dir(path):
    os.makedirs(path, mode=0o700, exist_ok=True)
    os.chmod(path, 0o700)


def today():
    return datetime.date.today().isoformat()


def who():
    try:
        return getpass.getuser()
    except Exception:
        return str(os.getuid())


# --- keys -------------------------------------------------------------------------------------------------

def own_recipient():
    path = key_path()
    if not os.path.isfile(path):
        raise Fail(f"no age key at {path}: run vallis-secret init")
    # age-keygen writes "# public key: age1…" into the key file: the agent's runtime then needs sops only
    with open(path, encoding="utf-8") as f:
        for line in f:
            if line.startswith("# public key: age1"):
                return line.split(":", 1)[1].strip()
    done = subprocess.run([program("VALLIS_AGE_KEYGEN", "age-keygen"), "-y", path],
                          capture_output=True, text=True)
    if done.returncode != 0:
        raise Fail(f"age-keygen -y: {done.stderr.strip()[-200:]}")
    return done.stdout.strip()


def admin_recipients():
    path = admin_path()
    if not os.path.isfile(path):
        return []
    out = []
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#"):
                if not line.startswith(("age1", "ssh-")):
                    raise Fail(f"{path}: {line[:12]}… is not an age public key")
                out.append(line)
    return out


def recipients():
    seen, out = set(), []
    for r in [own_recipient()] + admin_recipients():
        if r not in seen:
            seen.add(r)
            out.append(r)
    return out


# --- sops -------------------------------------------------------------------------------------------------

def sops_env():
    env = dict(os.environ)
    env["SOPS_AGE_KEY_FILE"] = key_path()
    env.pop("SOPS_AGE_KEY", None)
    return env


def sops_config(store):
    """Catch-all rule in the store, so a stray .sops.yaml elsewhere never decides recipients."""
    path = os.path.join(store, ".sops.yaml")
    text = "# vallis-secret: recipients and open fields come from its command line\ncreation_rules:\n  - path_regex: .*\n"
    if not os.path.isfile(path) or open(path, encoding="utf-8").read() != text:
        with open(path, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(path, 0o600)
    return path


def encrypt(doc, target, to=None):
    store = store_path()
    config = sops_config(store)
    folder = os.path.dirname(target)
    private_dir(folder)
    fd, tmp = tempfile.mkstemp(dir=folder, prefix=".new-", suffix=".json")
    try:
        with os.fdopen(fd, "wb") as out:
            done = subprocess.run(
                [program("VALLIS_SOPS", "sops"), "--config", config, "encrypt",
                 "--input-type", "json", "--output-type", "json",
                 "--unencrypted-regex", UNENCRYPTED, "--age", ",".join(to or recipients()),
                 "--filename-override", os.path.basename(target), "/dev/stdin"],
                input=json.dumps(doc).encode("utf-8"), stdout=out, stderr=subprocess.PIPE,
                cwd=store, env=sops_env())
        if done.returncode != 0:
            raise Fail(f"sops encrypt: {done.stderr.decode(errors='replace').strip()[-300:]}")
        os.chmod(tmp, 0o600)
        os.replace(tmp, target)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def decrypt_value(path):
    """Value as bytes; never printed."""
    return decrypt_doc(path)[1]


def decrypt_doc(path):
    """(open fields, value bytes); the value is never printed."""
    store = store_path()
    done = subprocess.run(
        [program("VALLIS_SOPS", "sops"), "--config", sops_config(store), "decrypt",
         "--input-type", "json", "--output-type", "json", path],
        capture_output=True, cwd=store, env=sops_env())
    if done.returncode != 0:
        # sops may echo parts of the file in errors, never the plaintext; keep only the tail
        raise Fail(f"cannot decrypt {os.path.basename(path)}: {done.stderr.decode(errors='replace').strip()[-200:]}")
    doc = json.loads(done.stdout)
    value = doc.get("value")
    if not isinstance(value, str):
        raise Fail(f"{os.path.basename(path)}: no value")
    if doc.get("encoding") == "base64":
        import base64
        return doc, base64.b64decode(value)
    return doc, value.encode("utf-8")


# --- store ------------------------------------------------------------------------------------------------

def entry_path(level, name):
    return os.path.join(store_path(), level, check_name(name) + ".json")


def find(name):
    for level in LEVELS:
        path = entry_path(level, name)
        if os.path.isfile(path):
            return level, path
    raise Fail(f"{name}: not in the store (vallis-secret list)")


def read_open(path):
    """Open fields and sops metadata; the encrypted value stays as ENC[…] and is dropped."""
    with open(path, encoding="utf-8") as f:
        doc = json.load(f)
    meta = doc.get("sops") or {}
    row = {k: doc.get(k) for k in OPEN_FIELDS if k in doc and k != "encoding"}
    row["recipients"] = len(meta.get("age") or [])
    row["updated"] = row.get("updated") or meta.get("lastmodified")
    return row


def put_value(name, value, what, source, level="agent"):
    if not what or not what.strip():
        raise Fail("--what: say what this is for")
    if source not in SOURCES:
        raise Fail(f"--source: one of {', '.join(SOURCES)}")
    if not value:
        raise Fail("empty value")
    if len(value) > MAX_VALUE:
        raise Fail("value over 64 KiB")
    path = entry_path("own", name)
    created = today()
    if os.path.isfile(path):
        created = read_open(path).get("created") or created
    doc = {"name": name, "what": what.strip(), "level": level, "source": source,
           "created": created, "created_by": who(), "updated": today()}
    try:
        doc["value"] = value.decode("utf-8")
    except UnicodeDecodeError:
        import base64
        doc["value"], doc["encoding"] = base64.b64encode(value).decode("ascii"), "base64"
    encrypt(doc, path)
    return path


# --- commands ---------------------------------------------------------------------------------------------

def cmd_init(_):
    key = key_path()
    private_dir(os.path.dirname(key))
    if not os.path.isfile(key):
        done = subprocess.run([program("VALLIS_AGE_KEYGEN", "age-keygen"), "-o", key],
                              capture_output=True, text=True)
        if done.returncode != 0:
            raise Fail(f"age-keygen: {done.stderr.strip()[-200:]}")
    os.chmod(key, 0o600)
    store = store_path()
    private_dir(store)
    for level in LEVELS:
        private_dir(os.path.join(store, level))
    sops_config(store)
    print(own_recipient())


def generate(length):
    if length < 12 or length > 256:
        raise Fail("--length: 12…256")
    alphabet = string.ascii_letters + string.digits + "-_.!@#%^*+="
    while True:
        value = "".join(rnd.choice(alphabet) for _ in range(length))
        if (any(c.islower() for c in value) and any(c.isupper() for c in value)
                and any(c.isdigit() for c in value) and any(not c.isalnum() for c in value)):
            return value.encode("ascii")


def cmd_put(a):
    check_name(a.name)
    if a.generate == a.stdin:
        raise Fail("choose one: --generate or --stdin")
    if a.generate:
        value = generate(a.length)
    else:
        if sys.stdin.isatty():
            raise Fail("--stdin: pipe the value in; it is never typed into the command line")
        value = sys.stdin.buffer.read(MAX_VALUE + 1).rstrip(b"\r\n")
    put_value(a.name, value, a.what, a.source)
    print(f"stored {a.name}")


def parse_dotenv(text, name):
    """The dotenv line BB's secret form writes: NAME='v' | NAME="v" | NAME=v (single line, no escapes)."""
    found = None
    for line in text.splitlines():
        m = re.match(r"^\s*(?:export\s+)?" + re.escape(name) + r"\s*=(.*)$", line)
        if m:
            if found is not None:
                raise Fail(f"{name}: several assignments in the form's file")
            raw = m.group(1).strip()
            if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "'\"":
                raw = raw[1:-1]
            found = raw
    if not found:
        raise Fail(f"{name}: the form returned no value")
    return found.encode("utf-8")


def cmd_ask(a):
    check_name(a.name)
    if not a.what or not a.what.strip():
        raise Fail("--what: say what this is for")
    bb = os.environ.get("BB_CLI") or shutil.which("bb")
    if not bb:
        raise Fail("bb not found: ask works inside a BB thread")
    base = "/dev/shm" if os.path.isdir("/dev/shm") and os.access("/dev/shm", os.W_OK) else None
    folder = tempfile.mkdtemp(prefix="vallis-ask-", dir=base)
    os.chmod(folder, 0o700)
    target = os.path.join(folder, "form.env")
    try:
        done = subprocess.run([bb, "secret", "request", a.name, "--write-env", target,
                               "--purpose", a.what.strip(), "--describe", f"{a.name}={a.what.strip()}", "--json"],
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        if done.returncode != 0:
            raise Fail(f"bb secret request: {(done.stdout or done.stderr).strip()[-300:]}")
        with open(target, encoding="utf-8") as f:
            value = parse_dotenv(f.read(), a.name)
        put_value(a.name, value, a.what, "handed")
    finally:
        shutil.rmtree(folder, ignore_errors=True)
    print(f"stored {a.name}")


def cmd_import(a):
    check_name(a.name)
    path = os.path.abspath(os.path.expanduser(a.file))
    if not os.path.isfile(path):
        raise Fail(f"{path}: no such file")
    if os.path.getsize(path) > MAX_VALUE:
        raise Fail(f"{path}: over 64 KiB")
    with open(path, "rb") as f:
        value = f.read()
    put_value(a.name, value, a.what, a.source)
    print(f"stored {a.name} from {path}; the original file is left in place")


def cmd_run(a):
    command = a.command
    if not a.names or not command:
        raise Fail("usage: vallis-secret run NAME... -- COMMAND...")
    env = dict(os.environ)
    for name in a.names:
        _, path = find(check_name(name))
        value = decrypt_value(path)
        if b"\0" in value:
            raise Fail(f"{name}: binary value, use vallis-secret file")
        env[name] = value.decode("utf-8", errors="strict")
    try:
        os.execvpe(command[0], command, env)
    except FileNotFoundError:
        raise Fail(f"{command[0]}: command not found")


def cmd_file(a):
    _, path = find(check_name(a.name))
    value = decrypt_value(path)
    target = os.path.abspath(os.path.expanduser(a.path))
    store = store_path()
    if os.path.commonpath([target, store]) == store:
        raise Fail("the target file must be outside the store")
    folder = os.path.dirname(target)
    os.makedirs(folder, mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=folder, prefix=".vallis-")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb") as out:
            out.write(value)
        os.replace(tmp, target)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    print(f"wrote {a.name} to {target} (0600)")


def cmd_header(a):
    _, path = find(check_name(a.name))
    value = decrypt_value(path).decode("utf-8")
    if not re.fullmatch(r"[A-Za-z0-9-]+", a.header):
        raise Fail("--header: a header name such as Authorization")
    print(json.dumps({a.header: f"{a.scheme} {value}".strip()}))


def own_values():
    """{name: value bytes} of every key this account can decrypt; kept in memory only."""
    out = {}
    for row in rows()[0]:
        try:
            out[row["name"]] = decrypt_value(find(row["name"])[1])
        except Fail:
            continue
    return out


def cmd_leaks(a):
    values = {n: v for n, v in own_values().items() if len(v) >= 8}
    if not values:
        print("no keys to look for")
        return
    sources = []  # (label, bytes)
    if a.git_staged:
        names = subprocess.run(["git", "diff", "--cached", "--name-only", "-z", "--diff-filter=ACMR"],
                               capture_output=True, check=True).stdout.split(b"\0")
        for name in filter(None, names):
            blob = subprocess.run(["git", "show", b":" + name], capture_output=True)
            if blob.returncode == 0:
                sources.append((name.decode(errors="replace"), blob.stdout))
    else:
        store = store_path()
        for start in a.paths or ["."]:
            for folder, dirs, files in os.walk(start):
                dirs[:] = [d for d in dirs if d != ".git" and os.path.realpath(os.path.join(folder, d)) != store]
                for file in files:
                    path = os.path.join(folder, file)
                    try:
                        if os.path.islink(path) or os.path.getsize(path) > 32 * 1024 * 1024:
                            continue
                        with open(path, "rb") as f:
                            sources.append((path, f.read()))
                    except OSError:
                        continue
            if os.path.isfile(start):
                with open(start, "rb") as f:
                    sources.append((start, f.read()))
    found = [(label, name) for label, data in sources for name, value in values.items() if value in data]
    for label, name in found:
        print(f"{name} found in {label}")
    if found:
        raise Fail(f"{len(found)} leak(s): remove the values from these files (and change the keys if they left the server)")
    print(f"no values of {len(values)} key(s) in {len(sources)} file(s)")


def cmd_receive(a):
    source = os.path.abspath(os.path.expanduser(a.file))
    try:
        with open(source, encoding="utf-8") as f:
            doc = json.load(f)
    except (OSError, ValueError) as error:
        raise Fail(f"{source}: not a key file ({error})")
    name = check_name(str(doc.get("name") or ""))
    if doc.get("level") != "organization" or not isinstance(doc.get("sops"), dict):
        raise Fail(f"{source}: not an organization key made by vallis-secret grant")
    decrypt_value(source)  # this account must be among its recipients
    target = entry_path("org", name)
    private_dir(os.path.dirname(target))
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(target), prefix=".new-", suffix=".json")
    with os.fdopen(fd, "w", encoding="utf-8") as out:
        json.dump(doc, out)
    os.chmod(tmp, 0o600)
    os.replace(tmp, target)
    print(f"received {name}")


def cmd_grant(a):
    check_name(a.name)
    if a.generate == a.stdin:
        raise Fail("choose one: --generate or --stdin")
    if not a.what or not a.what.strip():
        raise Fail("--what: say what this is for")
    to = [own_recipient()]
    with open(os.path.expanduser(a.to), encoding="utf-8") as f:
        for line in f:
            line = line.split("#", 1)[0].strip()
            if line:
                if not line.startswith(("age1", "ssh-")):
                    raise Fail(f"{a.to}: {line[:12]}… is not an age public key")
                if line not in to:
                    to.append(line)
    if len(to) < 2:
        raise Fail(f"{a.to}: no recipients")
    value = generate(a.length) if a.generate else sys.stdin.buffer.read(MAX_VALUE + 1).rstrip(b"\r\n")
    if not value or len(value) > MAX_VALUE:
        raise Fail("empty value or over 64 KiB")
    doc = {"name": a.name, "what": a.what.strip(), "level": "organization", "source": "preset",
           "created": today(), "created_by": who(), "updated": today(), "value": value.decode("utf-8")}
    target = os.path.abspath(os.path.expanduser(a.out))
    encrypt(doc, target, to)
    print(f"granted {a.name} to {len(to) - 1} recipient(s): {target}")


def rows():
    out, problems = [], []
    store = store_path()
    for level in LEVELS:
        folder = os.path.join(store, level)
        if not os.path.isdir(folder):
            continue
        for file in sorted(os.listdir(folder)):
            if not file.endswith(".json") or file.startswith("."):
                continue
            path = os.path.join(folder, file)
            try:
                row = read_open(path)
            except (OSError, ValueError) as error:
                problems.append(f"{level}/{file}: {error}")
                continue
            row["name"] = file[:-5]
            row["level"] = "organization" if level == "org" else row.get("level") or "agent"
            mode = stat.S_IMODE(os.stat(path).st_mode)
            row["state"] = "present" if mode & 0o077 == 0 else "open permissions"
            out.append(row)
    return out, problems


def cmd_list(a):
    found, problems = rows()
    if getattr(a, "verify", False):
        for row in found:
            try:
                decrypt_value(find(row["name"])[1])
            except Fail:
                row["state"] = "cannot decrypt"
    if a.json:
        print(json.dumps({"store": store_path(), "secrets": found, "problems": problems},
                         ensure_ascii=False, indent=2))
        return
    if not found:
        print("store is empty")
    for r in found:
        print(f"{r['name']:<32} {r['level']:<13} {r.get('source') or '-':<7} {r.get('created') or '-':<10} "
              f"{r.get('what') or ''}")
    for p in problems:
        print(f"problem: {p}", file=sys.stderr)


def cmd_remove(a):
    path = entry_path("own", a.name)
    if not os.path.isfile(path):
        raise Fail(f"{a.name}: not among own secrets (organization keys are removed by the administrator)")
    os.unlink(path)
    print(f"removed {a.name}")


def main(argv=None):
    p = argparse.ArgumentParser(prog="vallis-secret", description="Agent credentials store (sops + age)")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("init").set_defaults(fn=cmd_init)
    s = sub.add_parser("put")
    s.add_argument("name")
    s.add_argument("--what", required=True)
    s.add_argument("--generate", action="store_true")
    s.add_argument("--length", type=int, default=24)
    s.add_argument("--stdin", action="store_true")
    s.add_argument("--source", default="agent", choices=SOURCES)
    s.set_defaults(fn=cmd_put)
    s = sub.add_parser("ask")
    s.add_argument("name")
    s.add_argument("--what", required=True)
    s.set_defaults(fn=cmd_ask)
    s = sub.add_parser("import")
    s.add_argument("name")
    s.add_argument("--file", required=True)
    s.add_argument("--what", required=True)
    s.add_argument("--source", default="handed", choices=SOURCES)
    s.set_defaults(fn=cmd_import)
    sub.add_parser("run", help="run NAME... -- COMMAND...")
    s = sub.add_parser("file")
    s.add_argument("name")
    s.add_argument("path")
    s.set_defaults(fn=cmd_file)
    s = sub.add_parser("header")
    s.add_argument("name")
    s.add_argument("--scheme", default="Bearer")
    s.add_argument("--header", default="Authorization")
    s.set_defaults(fn=cmd_header)
    s = sub.add_parser("leaks")
    s.add_argument("paths", nargs="*")
    s.add_argument("--git-staged", action="store_true")
    s.set_defaults(fn=cmd_leaks)
    s = sub.add_parser("receive")
    s.add_argument("file")
    s.set_defaults(fn=cmd_receive)
    s = sub.add_parser("grant")
    s.add_argument("name")
    s.add_argument("--what", required=True)
    s.add_argument("--to", required=True)
    s.add_argument("--out", required=True)
