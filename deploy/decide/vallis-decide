#!/usr/bin/env python3
"""vallis-decide [--timeout N] [--status] — quick decision by the server's decide service.

stdin: a Decisions-shaped request {"input": ..., "questions": [{"type": "choice"|"predicate"|"score", ...}]}
stdout: {"answers": [...], "provider": ..., "ms": ...}. No answer (service absent, no provider, timeout) —
exit code 1 and the reason on stderr. --status prints the service state (which provider answers).
The caller does not know the provider and needs no login of its own.
"""
import http.client
import json
import os
import socket
import sys

CONFIG = os.environ.get("DECIDE_CONFIG", "/etc/bb-decide/decide.env")


def socket_path():
    path = "/run/bb-decide.sock"
    try:
        with open(CONFIG) as f:
            for line in f:
                k, _, v = line.strip().partition("=")
                if k == "DECIDE_SOCKET" and v.strip():
                    path = v.strip()
    except OSError:
        pass
    return os.environ.get("DECIDE_SOCKET", path)


class UnixConnection(http.client.HTTPConnection):
    def __init__(self, path, timeout):
        super().__init__("localhost", timeout=timeout)
        self.path = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.path)


def call(path, payload=None, timeout=10.0):
    conn = UnixConnection(socket_path(), timeout)
    try:
        body = json.dumps(payload).encode() if payload is not None else None
        conn.request("POST" if body else "GET", path, body=body, headers={"Content-Type": "application/json"})
        r = conn.getresponse()
        data = r.read()
    except Exception as e:
        raise SystemExit(f"vallis-decide: service unavailable ({type(e).__name__})")
    finally:
        conn.close()
    try:
        out = json.loads(data)
    except ValueError:
        raise SystemExit("vallis-decide: bad answer")
    if r.status != 200:
        raise SystemExit(f"vallis-decide: {out.get('error') or r.status}")
    return out


def main(argv):
    timeout = 8.0
    if "--timeout" in argv:
        i = argv.index("--timeout")
        timeout = float(argv[i + 1])
        del argv[i:i + 2]
    if argv == ["--status"]:
        print(json.dumps(call("/health"), ensure_ascii=False))
        return 0
    if argv:
        print(__doc__, file=sys.stderr)
        return 2
    try:
        request = json.loads(sys.stdin.read())
    except ValueError:
        print("vallis-decide: stdin is not JSON", file=sys.stderr)
        return 2
    print(json.dumps(call("/decide", {"request": request, "timeout": timeout}, timeout + 2), ensure_ascii=False))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except SystemExit as e:
        if isinstance(e.code, str):
            print(e.code, file=sys.stderr)
            sys.exit(1)
        raise
